# Finglora Supabase Configuration Example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Free.ai API Configuration (api.free.ai) — PRIMARY vision extractor
# Self-hosted Qwen vision model, free tier, multimodal image support
FREEAI_API_KEY=sk-free-your_key_here

# YepAPI Configuration for AI Vision Extraction (yepapi.com) — TIER 2 fallback
# Requires $5 paid deposit to unlock AI models
YEPAPI_KEY=yep_sk_your_key_here

# Google Gemini Flash Vision — TIER 3 fallback
GEMINI_API_KEY=your_gemini_key_here

# Resend Transactional Email API (resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Finglora <onboarding@resend.dev>

# Admin Server Auth (generate random secrets in production)
ADMIN_SECRET_KEY=your_admin_master_password
ADMIN_RPC_SECRET=your_64_char_random_hex_secret
ADMIN_SESSION_SECRET=your_64_char_random_session_hmac_secret

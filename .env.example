# Finglora Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production Site URL (required for OAuth & email auth callback redirects)
NEXT_PUBLIC_SITE_URL=https://finglora.app

# Google Vertex AI Express Keys (used for nail extraction & virtual try-on)
GEMINI_API_KEY=your_primary_vertex_or_gemini_key
VERTEX_API_KEY_2=your_secondary_vertex_key_optional

# Resend Transactional Email API (verify your custom domain before production)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Finglora <hello@finglora.app>

# Admin Server Auth (generate random secrets in production)
ADMIN_SECRET_KEY=your_admin_master_password
ADMIN_RPC_SECRET=your_64_char_random_hex_secret
ADMIN_SESSION_SECRET=your_64_char_random_session_hmac_secret
